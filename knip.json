{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.js",
    "electron/main.js",
    "electron/preload.js",
    "scripts/*.{js,mjs}",
    "e2e/**/*.spec.js",
    "src/__tests__/**/*.test.js",
    "*.config.{js,mjs}"
  ],
  "project": ["src/**/*.{js,ts,vue}", "electron/**/*.js", "scripts/**/*.{js,mjs}"],
  "ignoreBinaries": ["release.sh"],
  "include": ["files"],
  "vue": true
}
